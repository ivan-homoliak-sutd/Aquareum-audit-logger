enclave {

    // includes that will be made to both trustd and untrusted part
    include "data_types.h"


    // define ECALLs
    trusted {

        public int ecall_initialize_evm(void);

        public int ecall_read_pub_state(
            [out, size=evm_state_size_pub] PublicSealedData_T* evm_state_pub,
            size_t evm_state_size_pub
        );

    };


    // define OCALLs
    untrusted {

        int ocall_save_evm_state(
            [in, size=sealed_size] const uint8_t* sealed_data,
            size_t sealed_size
        );

        int ocall_load_evm_state(
            [out, size=sealed_size]uint8_t* sealed_data,
            size_t sealed_size
        );

        int ocall_does_sealed_state_exist(void);

    };
};
